rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Durante el desarrollo se permite acceso abierto únicamente a las
    // colecciones de fincas y formularios. Antes de publicar la app,
    // reemplazar por reglas basadas en autenticación (ver README: Firebase
    // Anonymous Auth).
    match /fincas/{docId} {
      allow read, write: if true;
    }

    match /formularios-fincas/{docId} {
      allow read, write: if true;
    }

    // Cualquier otra colección queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
